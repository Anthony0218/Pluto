{
  "name": "keineahnung",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/credits/generate-notices.mjs && node scripts/go/copy-wasm.mjs",
    "prebuild": "node scripts/credits/generate-notices.mjs && node scripts/go/copy-wasm.mjs",
    "dev": "vite",
    "dev:all": "trap 'kill 0' EXIT; node server/party/index.ts & vite & wait",
    "build": "tsc -b && tsc -p tsconfig.party.json && tsc -p tsconfig.natura.json && vite build",
    "lint": "eslint .",
    "test:schafkopf": "node --test tests/schafkopf*.test.mjs",
    "test:natura": "node --test tests/*.test.mjs",
    "check:atlas": "tsc -p tsconfig.app.json --incremental false && tsc -p tests/typechecks/atlas-edge.json",
    "test:atlas": "node --test tests/atlas*.test.mjs",
    "test:eat-it": "node --test tests/eat-it*.test.mjs",
    "geography:sync": "node scripts/geography/sync-atlas.mjs && node scripts/geography/sync-atlas-extras.mjs && node scripts/geography/bundle-flag-media.mjs",
    "geography:extras": "node scripts/geography/sync-atlas-extras.mjs && node scripts/geography/bundle-flag-media.mjs",
    "preview": "vite preview",
    "test:ranked": "node --test tests/chess-ranked*.test.mjs tests/go-ranked*.test.mjs",
    "test:chess-custom": "node --test tests/chess-custom*.test.mjs",
    "test:card-builder": "node --test tests/card-builder-*.test.mjs",
    "party:server": "node server/party/index.ts",
    "check:natura": "tsc -p tsconfig.natura.json",
    "test:go": "node --test tests/go-*.test.mjs",
    "test:party": "node --test tests/party-*.test.mjs",
    "check:party": "tsc -p tsconfig.party.json",
    "test": "node --import ./tests/helpers/typescript-paths.mjs --test tests/*.test.mjs",
    "test:learning": "node --test tests/birthday-qr.test.mjs tests/final-tools.test.mjs tests/tool-push-database.test.mjs tests/tool-push-worker.test.mjs tests/tool-push-endpoint.test.mjs tests/life-tools.test.mjs tests/advanced-math.test.mjs tests/deeper-math.test.mjs tests/music-football.test.mjs tests/learning-tools-foundation.test.mjs tests/math-foundations.test.mjs tests/paper-arithmetic.test.mjs tests/practical-tools.test.mjs tests/learning-translations.test.mjs",
    "check:learning": "tsc -p tests/typechecks/learning-tools.json --incremental false",
    "check:landing": "node scripts/landing/capture.mjs",
    "check:landing:update": "node scripts/landing/capture.mjs --update",
    "check:life-tools": "node scripts/tools/check-life-tools.mjs",
    "check:push": "tsc -p tests/typechecks/tool-push.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@untitledui/icons": "^0.0.22",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "d3-geo": "^3.1.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.42.0",
    "motion": "^14.0.0",
    "pako": "^2.1.0",
    "pixi.js": "^8.21.0",
    "pnpm": "^12.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.21.0",
    "stockfish": "^18.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/pako": "^2.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fflate": "^0.8.2",
    "globals": "^17.11.0",
    "jsqr": "^1.4.0",
    "pngjs": "^5.0.0",
    "supabase": "^2.118.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
