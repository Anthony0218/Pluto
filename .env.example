# Copy to .env (or .env.local) and fill in. Never commit real values: .env and *.local are git-ignored.

# ---- Site (Vite client) — Supabase project used by the other games, accounts and dashboards ----------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ---- Supabase Edge Functions (set as function secrets in Supabase, not in the browser build) ---------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret-never-expose-to-the-client

# ---- Pluto Party authority (node server/party/index.ts) — all optional ------------------------------
# Listen address (defaults 127.0.0.1:8787; the Vite dev proxy forwards /party-socket there).
PARTY_PORT=8787
PARTY_HOST=127.0.0.1
# Comma-separated browser origins allowed to open the game socket. Required in production.
# PARTY_ORIGINS=https://your-site.example
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For (used for rate limiting).
# PARTY_TRUST_PROXY=1
# debug | info | warn | error | silent (default info)
# PARTY_LOG_LEVEL=info
# NODE_ENV=production

# ---- Pluto Party client (build time) — only when the authority is on another host -------------------
# VITE_PARTY_SERVER_URL=wss://party.your-site.example/party-socket

# Natura online uses the existing VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY above.
# No dedicated Natura server or additional environment variables are required.

# Edravane multiplayer also uses the existing Supabase project above.
# Deploy edravane-match and its migration. No dedicated Edravane server or WebSocket URL is required.
